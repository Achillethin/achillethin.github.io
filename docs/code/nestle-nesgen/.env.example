# Copy this file to `.env` in this same folder and fill in YOUR OWN values,
# obtained internally through NesGen. Never commit `.env` (it's gitignored) —
# and never put real internal URLs, hostnames or secrets in this .example file
# either, since it *is* committed.

# "claude" (Anthropic Messages shape) or "gpt" (OpenAI Chat Completions shape)
NESGEN_FORMAT=claude

# Your NesGen completion endpoint — leave blank here, fill in locally only.
NESGEN_URL=

# Your NesGen API key / bearer token — leave blank here, fill in locally only.
NESGEN_API_KEY=

# Only used when NESGEN_FORMAT=claude
NESGEN_ANTHROPIC_VERSION=bedrock-2023-05-31

# Set to "false" only if your internal gateway requires disabling TLS verification.
NESGEN_VERIFY_SSL=true
